# --- Machine Learning: Gradient Boosting ---
xgboost = ">=2.1.0,<4.0.0"
lightgbm = ">=4.5.0,<5.0.0"
# --- Data Visualization ---
matplotlib = ">=3.9.0,<4.0.0"
seaborn = ">=0.13.0,<1.0.0"
plotly = ">=5.18.0,<7.0.0"
# --- Utilities & Performance ---
tqdm = ">=4.66.0,<5.0.0"
