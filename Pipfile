[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
# --- Numerical Computing & Data Structures ---
# numpy 2.5.x is blocked: numba (0.65.1 and 0.66.0) requires numpy<2.5, and
# numba is the default PyTensor backend for this project.
numpy = ">=2.1.0,<3.0.0"
cython = ">=3.0.0"
pandas = ">=2.2.0,<4.0.0"
scipy = ">=1.16.0,<4.0.0"
statsmodels = ">=0.14.0,<3.0.0"
pyyaml = ">=6.0.0,<7.0.0"
# --- Machine Learning: Core Frameworks ---
scikit-learn = ">=1.7.0,<4.0.0"
imbalanced-learn = ">=0.14.0,<1.0.0"
# --- Machine Learning: Gradient Boosting ---
xgboost = ">=3.0.0,<4.0.0"
lightgbm = ">=4.6.0,<5.0.0"
# --- Data Visualization ---
matplotlib = ">=3.10.0,<4.0.0"
seaborn = ">=0.13.0,<1.0.0"
plotly = ">=6.0.0,<7.0.0"
# kaleido v1: static Plotly PNG export (`plotly_get_chrome -y` for Chromium).
kaleido = ">=1.0.0,<2.0.0"
# NetCDF engine for the Kalman-workflow DataTree artifact exports. h5py is
# the actual HDF5 backend h5netcdf drives (h5netcdf only declares it as an
# optional "h5py" extra, so it is NOT pulled in transitively) and must be
# pinned explicitly or DataTree.to_netcdf() raises ImportError at runtime.
h5netcdf = ">=1.4.0,<2.0.0"
h5py = ">=3.13.0,<4.0.0"
# --- Utilities & Performance ---
tqdm = ">=4.67.0,<5.0.0"
joblib = ">=1.5.0,<4.0.0"
xlsxwriter = ">=3.2.0,<4.0.0"
psutil = ">=7.0.0,<8.0.0"
# --- Bayesian / Probabilistic ---
# PyMC 6.0 + PyTensor 3.0 + ArviZ 1.0 ecosystem (2026 update).
# See https://www.pymc.io/blog/pymc_v6_ecosystem_updates.html for details.
#
# ArviZ 1.0 replaces the monolithic ``arviz`` package with a modular
# arviz-base / arviz-stats / arviz-plots split backed by
# ``xarray.DataTree`` (see the ArviZ migration guide:
# https://python.arviz.org/en/latest/user_guide/migration_guide.html).
# PyMC v5 is NOT compatible with arviz 1.0 — PyMC 6 is required.
# The shim at probabilistic_ml_model/_pymc_arviz_compat.py keeps the
# legacy ``arviz.InferenceData`` import path working as a thin
# re-export over arviz-base for downstream type annotations
# (``InferenceLike = Union[arviz.InferenceData, xarray.DataTree]``).
arviz = ">=1.1.0,<2.0.0"
arviz-base = ">=1.1.0,<2.0.0"
arviz-stats = ">=1.1.0,<2.0.0"
arviz-plots = ">=1.1.0,<2.0.0"
# pymc 6.2 <-> pytensor 3.2 are mutually required (pymc 6.1 caps pytensor<3.2,
# pymc 6.2 requires pytensor>=3.2.2,<3.3) — bump the pair together.
pymc = ">=6.2.0,<7.0.0"
pytensor = ">=3.2.2,<4.0.0"
bambi = ">=0.19.0,<1.0.0"
nutpie = ">=0.16.0,<1.0.0"
xarray = ">=2026.1.0,<2027.0.0"
jax = ">=0.11.0,<1.0.0"
jaxlib = ">=0.11.0,<1.0.0"
# --- Hyperparameter Optimization ---
optuna = ">=4.5.0,<5.0.0"
# --- Networking ---
requests = ">=2.32.0"
# --- Database ---
psycopg2-binary = ">=2.9.9,<3.0.0"
sqlalchemy = ">=2.0.30,<3.0.0"
# --- Dashboards ---
dash = ">=4.0.0,<7.0.0"
dash-bootstrap-components = ">=2.0.0,<4.0.0"
flask = ">=3.1.0,<4.0.0"
# --- Now Python 3.14-compatible (ungated) ---
shap = ">=0.52.0,<1.0.0"
# pytensor 3.2.4 raised its numba cap to <=0.66.0 (was <=0.65.1), unblocking
# numba 0.66 + llvmlite 0.48. numpy must stay <2.5 (numba 0.66 requirement).
numba = ">=0.65.0,<1.0.0"
# catboost 1.2.10 (Feb 2026) added cp314 wheels — no longer gated.
# See https://github.com/catboost/catboost/issues/2943.
catboost = ">=1.2.10"
numpyro = ">=0.18.0"
blackjax = ">=1.6.0"
ipykernel = "*"
# Required so tqdm.auto finds IProgress under Jupyter (silences TqdmWarning).
ipywidgets = ">=8.1.0,<9.0.0"
webcolors = "*"
nbformat = "==5.10.4"
pympler = "*"

[dev-packages]
pytest = ">=9.0.0,<12.0.0"
pytest-cov = ">=7.0.0,<20.0.0"
black = ">=26.0.0,<30.0.0"
flake8 = ">=7.3.0,<19.0.0"
mypy = ">=1.20.0,<1.30.0"
isort = ">=8.0.0,<11.0.0"
pip-tools = ">=7.5.0,<30.0.0"

# --- Python <3.14 only packages (streamlit, tensorflow, scikeras) ---
# Intentionally NOT declared here. These have no cp314 wheels, and this Pipfile
# locks against python_version = "3.14" (below). pipenv resolves the lock with a
# single interpreter, so it cannot pin a package that has no 3.14 candidate — it
# would skip them and write a malformed `streamlit==>=1.40.0,<6.0.0` version
# (doubled `==>=`), which is invalid PEP 508 and crashes `pipenv lock`.
# On Python <3.14, install them via pip's marker-aware paths instead:
#   pip install -r requirements.txt            (markered: python_version < '3.14')
#   pip install ".[dashboards,tensorflow]"     (markered pyproject extras)

[requires]
python_version = "3.14"