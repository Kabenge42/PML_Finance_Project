[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
# Core dependencies
numpy = ">=1.26.0,<3.0.0"
pandas = ">=2.2.0,<4.0.0"
scipy = ">=1.14.0,<2.0.0"
statsmodels = ">=0.14.0,<1.0.0"
scikit-learn = ">=1.6.0,<2.0.0"
imbalanced-learn = ">=0.12.0,<1.0.0"
xgboost = ">=2.1.0,<4.0.0"
lightgbm = ">=4.5.0,<5.0.0"
matplotlib = ">=3.9.0,<4.0.0"
seaborn = ">=0.13.0,<1.0.0"
plotly = ">=5.18.0,<7.0.0"
tqdm = ">=4.66.0,<5.0.0"
joblib = ">=1.4.0,<2.0.0"
xlsxwriter = ">=3.2.0,<4.0.0"
psutil = ">=6.0.0,<7.0.0"
optuna = ">=4.1.0,<5.0.0"
arviz = ">=0.19.0,<8.0.0"
pymc = ">=4.0.0,<8.0.0"
pytensor = ">=2.0.0,<5.0.0"
xarray = ">=2025.0.0,<2027.0.0"
# Python <3.14 only packages
catboost = { version = ">=1.2.5,<2.0.0", markers = "python_version < '3.14'" }
shap = { version = ">=0.50.0,<1.0.0", markers = "python_version < '3.14'" }
streamlit = { version = ">=1.40.0,<2.0.0", markers = "python_version < '3.14'" }
tensorflow = { version = ">=2.15.0,<3.0.0", markers = "python_version < '3.14'" }
scikeras = { version = ">=0.13.0,<1.0.0", markers = "python_version < '3.14'" }
numba = { version = ">=0.60.0,<1.0.0", markers = "python_version < '3.14'" }

[dev-packages]
pytest = ">=8.3.0,<9.0.0"
pytest-cov = ">=5.0.0,<6.0.0"
black = ">=24.0.0,<26.0.0"
flake8 = ">=7.1.0,<8.0.0"
mypy = ">=1.11.0,<2.0.0"
isort = ">=5.13.0,<6.0.0"
pip-tools = ">=7.4.0,<8.0.0"

[requires]
python_version = "3.12"
